<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-feature android:name="android.hardware.telephony" android:required="false" />

    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <!-- List of SIM cards for choosing the sending slot -->
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <!-- STATUS and timeouts on time while the app is closed. Exact alarms: granted by default up to
         Android 12, USE_EXACT_ALARM from 13 (Google Play limits it, the app is not there) -->
    <uses-permission
        android:name="android.permission.SCHEDULE_EXACT_ALARM"
        android:maxSdkVersion="32" />
    <uses-permission android:name="android.permission.USE_EXACT_ALARM" />
    <!-- The result of a command while the app is closed -->

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:theme="@style/AppTheme">

        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <activity
            android:name=".SettingsActivity"
            android:exported="false"
            android:label="@string/settings"
            android:windowSoftInputMode="adjustResize" />

        <!-- Replies from Altox, also when the app is closed -->
        <receiver
            android:name=".SmsReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_RECEIVED" />
            </intent-filter>
        </receiver>

        <!-- Sends the planned STATUS after a command -->
        <receiver
            android:name=".PollReceiver"
            android:exported="false" />

        <!-- Result of sending our own SMS -->
        <receiver
            android:name=".SentReceiver"
            android:exported="false" />
    </application>
</manifest>
